{
  "name": "@mavisdraw/compat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./repo": {
      "node": {
        "types": "./dist/repo/index.d.ts",
        "default": "./dist/repo/index.js"
      },
      "types": "./src/repo/index.ts",
      "default": "./src/repo/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@mavisdraw/types": "workspace:*"
  },
  "devDependencies": {
    "jsdom": "^28.1.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
