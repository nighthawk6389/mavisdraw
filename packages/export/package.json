{
  "name": "@mavisdraw/export",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./svg-markup": {
      "node": {
        "types": "./dist/svgMarkup.d.ts",
        "default": "./dist/svgMarkup.js"
      },
      "types": "./src/svgMarkup.ts",
      "default": "./src/svgMarkup.ts"
    },
    "./library": {
      "node": {
        "types": "./dist/library.d.ts",
        "default": "./dist/library.js"
      },
      "types": "./src/library.ts",
      "default": "./src/library.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@mavisdraw/types": "workspace:*",
    "@mavisdraw/math": "workspace:*",
    "pdf-lib": "^1.17.1",
    "roughjs": "^4.6.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
