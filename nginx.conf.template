# The web image's nginx (a template: ${...} come from the environment at start).
#
# One address for everything: the app's files, and /api plus the live
# collaboration socket passed on to the API server (API_UPSTREAM). The app
# then needs no CORS, and its session cookie is first-party.

# Behind another proxy (e.g. Caddy for HTTPS), keep the scheme it saw
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

# The address as the browser or agent used it, port included ($host drops
# it): the API builds sign-in addresses (OAuth metadata, the SSO callback)
# from it, and on :8080 they must say :8080
map $http_host $forwarded_host {
    default $http_host;
    ''      $host;
}

server {
    listen 3000;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # The API's name is resolved per request (Docker's DNS by default), so
    # this container starts even when the API isn't up yet
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $api ${API_UPSTREAM};

    # Diagram saves and imports can be large
    client_max_body_size 25m;

    location /api/ {
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Host $forwarded_host;
        proxy_set_header X-Forwarded-Host $forwarded_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        # The AI agent and MCP stream their answers
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # Coding agents learn here how to sign in (OAuth metadata, RFC 9728 and 8414)
    location /.well-known/oauth- {
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Host $forwarded_host;
        proxy_set_header X-Forwarded-Host $forwarded_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location /collaboration {
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $forwarded_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        # Live sessions stay open for hours
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # The embed viewer is meant to be framed by other sites (docs, wikis)
    location = /embed.html {
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Cache-Control "no-cache";
    }

    # Built files have content hashes in their names
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff always;
    }

    # The app (single-page: every other path is index.html)
    location / {
        try_files $uri $uri/ /index.html;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Content-Security-Policy "frame-ancestors 'self'" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }
}
