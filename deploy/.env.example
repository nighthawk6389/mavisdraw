# Every setting a self-hosted MavisDraw reads. ./setup.sh writes .env with
# the required ones (and fresh secrets); copy any of the rest into it.

# ── Required (setup.sh fills these in) ───────────────────────
# The address people open
APP_URL=https://draw.example.com
# Random values. JWT_SECRET and COOKIE_SECRET: at least 32 characters.
POSTGRES_PASSWORD=
JWT_SECRET=
COOKIE_SECRET=
# 64 hex characters: encrypts the GitHub tokens people connect
GITHUB_TOKEN_ENCRYPTION_KEY=

# ── Serving ──────────────────────────────────────────────────
# For the bundled Caddy (docker compose --profile https up -d)
# DOMAIN=draw.example.com
# The web container's port on this host (127.0.0.1:8080 keeps it local)
# HTTP_PORT=8080
# Proxies in front of the API: 2 if you put your own proxy in front of the web container
# TRUST_PROXY=1
# Image tag: a release (e.g. 1.4.0) to pin it, or latest
# MAVISDRAW_VERSION=latest
# MAVISDRAW_IMAGE=ghcr.io/nighthawk6389/mavisdraw
# LOG_LEVEL=info

# ── Email: invites, @mentions, confirming addresses ──────────
# smtp | resend | postmark | none
# MAIL_PROVIDER=smtp
# MAIL_FROM=MavisDraw <mavisdraw@example.com>
# smtps://…:465 for implicit TLS
# SMTP_URL=smtp://user:password@smtp.example.com:587
# RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=

# ── GitHub (docs/github-oauth-setup.md, docs/pr-checks.md) ───
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GitHub Enterprise Server
# GITHUB_ENTERPRISE_URL=https://github.example.com
# GITHUB_ENTERPRISE_CLIENT_ID=
# GITHUB_ENTERPRISE_CLIENT_SECRET=
# Pull-request checks (the GitHub App)
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_APP_SLUG=

# ── AI assistant ─────────────────────────────────────────────
# ANTHROPIC_API_KEY=

# ── Error reporting ──────────────────────────────────────────
# SENTRY_DSN=
